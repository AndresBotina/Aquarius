---
import { ROW_1, ROW_2 } from '../../data/tech-stack';
import type { Tech } from '../../data/tech-stack';
import * as simpleIcons from 'simple-icons';

// Cada track duplica su fila para que translateX(-50%) haga un loop sin costura.
const track1: Tech[] = [...ROW_1, ...ROW_1];
const track2: Tech[] = [...ROW_2, ...ROW_2];

// Resuelve el SVG del icono en build time. `null` si el slug no existe
// en simple-icons (p. ej. twilio) → el item cae al fallback de solo-nombre.
function getIcon(slug: string): string | null {
  const key = `si${slug.charAt(0).toUpperCase()}${slug.slice(1)}`;
  const icon = (simpleIcons as Record<string, any>)[key];
  return icon?.svg ?? null;
}
---

<section class="tech-marquee" aria-label="Tecnologías">
  <div class="marquee-row" data-direction="left">
    <div class="marquee-track">
      {track1.map((tech) => (
        <div class="marquee-item">
          {(() => {
            const svg = getIcon(tech.icon);
            return svg
              ? <span class="contact-icon" set:html={svg} />
              : null;
          })()}
          <span>{tech.name}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="marquee-row" data-direction="right">
    <div class="marquee-track">
      {track2.map((tech) => (
        <div class="marquee-item">
          {(() => {
            const svg = getIcon(tech.icon);
            return svg
              ? <span class="contact-icon" set:html={svg} />
              : null;
          })()}
          <span>{tech.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tech-marquee {
    width: 100%;
    overflow: hidden;
    padding: 3rem 0;
  }

  .marquee-row {
    overflow: hidden;
    white-space: nowrap;
  }

  .marquee-row + .marquee-row {
    margin-top: 1.5rem;
  }

  .marquee-track {
    display: inline-flex;
    gap: 3rem;
    animation: marquee-scroll 35s linear infinite;
  }

  .marquee-row[data-direction="right"] .marquee-track {
    animation-direction: reverse;
  }

  @keyframes marquee-scroll {
    from { transform: translateX(0);     }
    to   { transform: translateX(-50%);  }
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .marquee-item svg {
    width: 28px;
    height: 28px;
    fill: rgba(255, 255, 255, 0.45);
  }

  .marquee-item span {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.45);
    letter-spacing: 0.02em;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
